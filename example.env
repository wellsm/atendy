# Copy to local.env. Never commit local.env.
# Local commands (serve, test, admin) always use the Docker Postgres from docker-compose.yml.
# EZ4_RAW_PG_DB_URL is read only by `ez4 deploy`: Neon pooled connection string (host contains "-pooler").
EZ4_RAW_PG_DB_URL=
# Evolution API (local Docker). Global key is used only by admin scripts.
EVOLUTION_API_URL=http://127.0.0.1:8081
EVOLUTION_API_KEY=atendy_evolution_local_key
# Base URL Evolution uses to call the webhook, e.g. http://host.docker.internal:3746/<path printed by `npm run serve`>
WEBHOOK_BASE_URL=
# Web app origin, no trailing slash: the bot sends <WEB_BASE_URL>/<slug> as the menu link.
WEB_BASE_URL=http://localhost:3000
# Google Maps Platform key with only the Geocoding API enabled (distance delivery).
GOOGLE_MAPS_API_KEY=
# OpenRouter: LLM (model per store, stores.llm_model) and Jev (stores with router=jev, ~typesafe/jev-latest).
OPENROUTER_API_KEY=
# Anthropic API key for stores on `anthropic-direct/...` models (Ez4 refuses empty variables: any placeholder works
# while no store uses one).
ANTHROPIC_API_KEY=
# Store panel auth (Clerk). PEM public key from Clerk Dashboard → API keys → JWT public key (networkless verify).
CLERK_JWT_KEY=
# Clerk user ids (user_...) allowed into /admin, comma-separated.
ADMIN_USER_IDS=
# New-store notification (Telegram Bot API). Ez4 refuses empty variables: any placeholder disables nothing, it just
# makes the best-effort send fail silently.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Store card billing (Asaas). Sandbox on local/dev: https://api-sandbox.asaas.com/v3 ; prd: https://api.asaas.com/v3.
# ASAAS_WEBHOOK_TOKEN is the "token de autenticação" set in the Asaas webhook (POST <api>/webhooks/asaas).
# Asaas keys start with "$": escape every "$" as "\$" (dotenv-cli expands it; quotes do not help).
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Web order phone codes: WhatsApp Cloud API number of Atendy (Meta → WhatsApp → API Setup → Phone number ID) and a
# permanent System User token with whatsapp_business_messaging. "local" as phone id skips the send and returns the
# code to the checkout (local dev only, never on dev/prd). Template: otp_code_pt_br_v1 (authentication, pt_BR).
WHATSAPP_OTP_PHONE_ID=local
WHATSAPP_OTP_TOKEN=local
# Long random string (openssl rand -hex 32): signs the browser's "phone verified" token; changing it logs every
# phone out.
WEB_PHONE_TOKEN_SECRET=
# Code delivery webhook (POST/GET <api>/webhooks/whatsapp-cloud, field "messages"): a random verify token you also type
# in Meta → app → WhatsApp → Configuration → Webhook, and the app secret (app → Settings → Basic → App secret).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Prospecting module on/off (`false` stops the cron, the webhook and the admin routes)
PROSPECTING_ENABLED=true
