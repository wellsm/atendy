# Copy to .env.local (git-ignored).
# Clerk Dashboard → API keys → Publishable key.
VITE_CLERK_PUBLISHABLE_KEY=
# Local API printed by `npm run serve` (base path included).
VITE_API_URL=http://localhost:3746/dev-atendy-api

AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Panel WebSocket printed by `npm run serve` (service PanelSocket). Empty: the panel only polls.
VITE_REALTIME_URL=ws://localhost:3746/dev-atendy-panel-socket
